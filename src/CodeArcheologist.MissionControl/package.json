{
  "name": "code-archeologist-mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:live": "node --experimental-strip-types --test tests/*.e2e.mjs",
    "browser:install": "playwright install chromium",
    "test:browser": "playwright test --config playwright.config.mjs",
    "benchmark:atlas": "node --experimental-strip-types tests/atlas-benchmark.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.8",
    "@microsoft/signalr": "10.0.11",
    "@xyflow/react": "12.11.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
